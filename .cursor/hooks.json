{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "python3 ./hooks/no-ai-attribution.py",
        "timeout": 10,
        "failClosed": true
      },
      {
        "command": "python3 ./hooks/git-text-style.py",
        "timeout": 10,
        "failClosed": false
      }
    ],
    "sessionStart": [
      {
        "command": "python3 ./hooks/sync-rules.py",
        "timeout": 10,
        "failClosed": false
      }
    ],
    "stop": [
      {
        "command": "python3 ./hooks/sync-rules.py",
        "timeout": 10,
        "failClosed": false
      }
    ]
  }
}
